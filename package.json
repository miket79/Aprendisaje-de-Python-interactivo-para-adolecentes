{
  "name": "python-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:setup": "bash tools/tts/setup.sh",
