    "package": "bash tools/launcher/build.sh"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "howler": "^2.2.4",
    "i18next": "^26.5.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
